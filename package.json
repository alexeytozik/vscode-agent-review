{
  "name": "agent-review",
  "displayName": "Agent Review",
  "description": "Review individual changes from each request directly in the editor.",
  "version": "0.7.3",
  "publisher": "alexeytozik",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./review.js",
  "scripts": {
    "test": "node test/run-unit.js",
    "test:migration": "node test/run-unit.js --migration",
    "test:all-unit": "node test/run-unit.js --all",
    "package": "vsce package",
    "test:editor": "node test/run-editor.js",
    "test:renderer": "node test/run-browser.js",
    "test:performance": "node test/run-browser.js --performance",
    "test:live": "node test/run-editor.js --live"
  },
  "contributes": {
    "commands": [
      {
        "command": "changeReview.diagnostics",
        "title": "Agent Review: Show Local Diagnostics"
      },
      {
        "command": "changeReview.cleanup",
        "title": "Agent Review: Clean Up Local Data"
      },
      {
        "command": "changeReview.show",
        "title": "Agent Review: Open",
        "icon": "$(diff)"
      },
      {
        "command": "changeReview.queue",
        "title": "Agent Review: Review Queue",
        "icon": "$(list-tree)"
      },
      {
        "command": "changeReview.next",
        "title": "Agent Review: Next Change"
      },
      {
        "command": "changeReview.previous",
        "title": "Agent Review: Previous Change"
      },
      {
        "command": "changeReview.fileActions",
        "title": "Agent Review: File and Request Actions",
        "icon": "$(checklist)"
      },
      {
        "command": "changeReview.forget",
        "title": "Agent Review: Discard Saved Snapshot"
      },
      {
        "command": "changeReview.status",
        "title": "Agent Review: Integration Status"
      },
      {
        "command": "changeReview.toggle",
        "title": "Agent Review: Toggle Review"
      },
      {
        "command": "changeReview.enable",
        "title": "Review Disabled — Enable",
        "icon": "$(circle-slash)"
      },
      {
        "command": "changeReview.disable",
        "title": "Review Enabled — Disable",
        "icon": "$(check)"
      },
      {
        "command": "changeReview.acceptAll",
        "title": "Agent Review: Accept All Pending Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "changeReview.connect",
        "title": "Agent Review: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "changeReview.disconnect",
        "title": "Agent Review: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "changeReview.accept",
        "title": "Agent Review: Keep Change",
        "icon": "$(check)"
      },
      {
        "command": "changeReview.reject",
        "title": "Agent Review: Undo Change",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "changeReview.show",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "changeReview.next",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "changeReview.inEditor"
      },
      {
        "command": "changeReview.previous",
        "key": "alt+[",
        "mac": "alt+[",
        "when": "changeReview.inEditor"
      },
      {
        "command": "changeReview.toggle",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      },
      {
        "command": "changeReview.accept",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "changeReview.inEditor && editorTextFocus"
      },
      {
        "command": "changeReview.reject",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "changeReview.inEditor && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Agent Review",
      "properties": {
        "changeReview.exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 128,
          "uniqueItems": true,
          "default": [],
          "scope": "window",
          "description": "Additional root-relative glob exclusions, including dotfiles. Use / separators, without absolute paths, .. or negation. Default credential exclusions always apply. Gitignored paths are otherwise eligible."
        },
        "changeReview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the first pending change when a request finishes."
        },
        "changeReview.view": {
          "type": "string",
          "enum": [
            "review",
            "editor"
          ],
          "default": "review",
          "scope": "window",
          "description": "Use the separate review tab, or the compatibility controls in ordinary text editors."
        },
        "changeReview.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable review of confirmed apply_patch edits after writing. Connection setup and trusted hooks are required; shell and Python writes need manual review."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "changeReview.accept",
          "when": "changeReview.inEditor && !changeReview.nativeControls",
          "group": "navigation@1"
        },
        {
          "command": "changeReview.reject",
          "when": "changeReview.inEditor && !changeReview.nativeControls",
          "group": "navigation@2"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "dependencies": {
    "diff": "9.0.0",
    "picomatch": "4.0.7"
  },
  "author": {
    "name": "alexeytozik",
    "email": "tozikalexey@gmail.com"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeytozik/vscode-agent-review.git"
  },
  "preview": true,
  "keywords": [
    "review",
    "diff",
    "changes",
    "inline"
  ],
  "homepage": "https://github.com/alexeytozik/vscode-agent-review",
  "bugs": {
    "url": "https://github.com/alexeytozik/vscode-agent-review/issues"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "playwright-core": "1.64.1"
  },
  "extensionKind": [
    "ui"
  ]
}
